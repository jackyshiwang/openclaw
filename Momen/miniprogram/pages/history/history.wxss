.container {
  padding: 20rpx;
  background-color: #f7f7f7;
  min-height: 100vh;
}

.tabs {
  display: flex;
  margin-bottom: 30rpx;
  background: #fff;
  padding: 10rpx;
  border-radius: 16rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 15rpx 0;
  font-size: 28rpx;
  color: #666;
  border-radius: 10rpx;
}

.tab.active {
  background: #e6f7ff;
  color: #007aff;
  font-weight: bold;
}

.list {
  height: calc(100vh - 120rpx);
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.card-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
  font-size: 24rpx;
  color: #999;
}

.sync-status.synced {
  color: #52c41a;
}

.sync-status.unsynced {
  color: #faad14;
}

.card-content {
  margin-bottom: 20rpx;
}

.summary {
  font-size: 30rpx;
  color: #333;
  line-height: 1.6;
  margin-bottom: 10rpx;
}

.quote {
  font-size: 28rpx;
  color: #666;
  font-style: italic;
  background: #f9f9f9;
  padding: 15rpx;
  border-radius: 10rpx;
  margin-top: 10rpx;
}

.tags {
  display: flex;
  flex-wrap: wrap;
}

.tag {
  font-size: 22rpx;
  color: #007aff;
  background: #e6f7ff;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-right: 10rpx;
}

.empty-state {
  text-align: center;
  color: #999;
  margin-top: 100rpx;
  font-size: 28rpx;
}

